{
    "backend": "corfu",
    "corfu_endpoint": "localhost:9000",
    "corfu_jar_path": "/path/to/corfu-bridge-all.jar",
    "corfu_jvm_opts": "-Xmx1g",
    "corfu_stream_name": "ozonedb-test",
    "db_path": "test/db/",
    "mode": 1,
    "task_prefix": "task/",
    "log_file_size_limit": 1024,
    "base_file_number_limit": 4,
    "level_size": "[4096, 40960, 409600]",
    "level_file_size_limit": "[4096, 40960, 409600]",
    "max_level": 3,
    "compaction_policy": 0,
    "cloud": 0,
    "sstable_backend": "s3",
    "s3_endpoint": "http://127.0.0.1:9090",
    "s3_region": "us-east-1",
    "s3_bucket": "ozonedb-sstables",
    "s3_access_key": "minioadmin",
    "s3_secret_key": "minioadmin",
    "s3_use_path_style": "true",
    "sstable_dir": "test-cluster"
}
