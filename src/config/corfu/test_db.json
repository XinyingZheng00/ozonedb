{
    "backend": "corfu",
    "corfu_endpoint": "localhost:9000",
    "corfu_jar_path": "/path/to/corfu-bridge-all.jar",
    "corfu_jvm_opts": "-Xmx1g",
    "corfu_stream_name": "ozonedb-test",
    "db_path": "test/db/",
    "mode": 1,
    "task_prefix": "task/",
    "log_file_size_limit": 1024,
    "base_file_number_limit": 4,
    "level_size": "[4096, 40960, 409600]",
    "level_file_size_limit": "[4096, 40960, 409600]",
    "max_level": 3,
    "compaction_policy": 0,
    "cloud": 0
}
