# Yahoo! Cloud System Benchmark
# Workload AZ: workload A (50/50 read/update) with a zipfian over the key space
#
# Why this file exists (bench/PLAN-cost-2.md, Task 0b): workload A's
# "requestdistribution=zipfian" is a ScrambledZipfianGenerator over 10^10
# items folded onto the loaded keys by fnvhash64. Beyond a few hundred hot
# keys that is close to uniform, and the block-cache hit rate it measures
# is what a uniform stream gives. "zipfian_keyspace" (a branch added to
# CoreWorkload.java) draws a zipfian (theta 0.99) over the loaded key
# numbers themselves, so the top k keys carry zeta(k)/zeta(N) of the
# requests. The default insertorder=hashed keeps the hot records scattered
# over every SSTable: only the request stream is skewed, not the layout.
#
# The two-letter name is on purpose: the result files carry "workloadaz",
# the extractor reads wl=az, and nothing else in the chain reads the letters.
# The key-space corpus is kept apart from the scrambled corpus (own run tag,
# own TSV, own model run); never put both in one model run.
#
#   Read/update ratio: 50/50
#   Default data size: 1 KB records (10 fields, 100 bytes each, plus key)
#   Request distribution: zipfian over the key space

recordcount=1000
operationcount=1000
workload=site.ycsb.workloads.CoreWorkload

readallfields=true

readproportion=0.5
updateproportion=0.5
scanproportion=0
insertproportion=0

requestdistribution=zipfian_keyspace

